---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---
<section class="contact" aria-labelledby="contact-title">
  <div class="wrap contact__in">
    <div>
      <h2 id="contact-title">Get in touch</h2>
      <p>For research collaborations, engineering roles or training, email is the best way to reach me.</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--solid-light" href={profile.linkedin} data-email={profile.email}><Icon name="mail" /> Email me</a>
      <a class="btn btn--light" href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn <Icon name="out" /></a>
      <a class="btn btn--light" href={profile.linkedin} data-phone={profile.phone}><Icon name="phone" /> <span>Phone</span></a>
    </div>
  </div>
</section>

---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex contact={false}>
  <div class="wrap">
    <header class="page-head" style="min-height:56vh">
      <p class="eyebrow">404</p>
      <h1>Tracking lost</h1>
      <p class="lead">This page is not on the map. The home page is a good place to relocalize.</p>
      <p style="margin-top:1.5rem"><a class="btn btn--primary" href="/">Back to home</a></p>
    </header>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import { awards, education, profile, skills } from '../data/profile';
import { getExperience, getProjects, getResearch, getTeaching, statusLabel } from '../data/content';
const [experience, research, teaching, projects] = await Promise.all([getExperience(), getResearch(), getTeaching(), getProjects()]);
const sections = [['experience', 'Experience'], ['education', 'Education'], ['publications', 'Publications'], ['teaching', 'Teaching'], ['projects', 'Projects'], ['skills', 'Skills'], ['awards', 'Awards']];
---
<Base title="CV" description="Curriculum vitae of Hatim Asslik: experience, education, publications, teaching, projects and skills.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Curriculum vitae</p>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.headline}</p>
    </header>
    <div class="cv" style="padding-bottom:var(--section)">
      <aside class="cv__side">
        <ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        <a class="btn btn--primary" href={profile.cv} download={profile.cvName}><Icon name="download" /> Download PDF</a>
      </aside>
      <div>
        <section aria-labelledby="experience">
          <SectionHead id="experience" title="Experience" />
          {experience.map(({ data }) => (
            <article class="job">
              <span class="meta">{data.period}</span>
              <div>
                <h3>{data.role}</h3>
                <p class="job__org">{data.org}</p>
                <ul class="bullets">{data.bullets.map((b) => <li>{b}</li>)}</ul>
                <ul class="tags">{data.keywords.map((k) => <li>{k}</li>)}</ul>
                {data.related.length > 0 && <div class="job__links">{data.related.map((l) => <a class="more" href={l.href}>{l.label}</a>)}</div>}
              </div>
            </article>
          ))}
        </section>
        <section aria-labelledby="education">
          <SectionHead id="education" title="Education" />
          {education.map((e) => <article class="job"><span class="meta">{e.period}</span><div><h3>{e.title}</h3><p class="job__org">{e.place}</p></div></article>)}
        </section>
        <section aria-labelledby="publications">
          <SectionHead id="publications" title="Publications and ongoing research" />
          {research.map(({ id, data }) => (
            <article class="job">
              <span class:list={['status', `status--${data.status}`]}>{data.year ?? statusLabel[data.status]}</span>
              <div><h3><a href={`/research/${id}/`} style="text-decoration:none">{data.title}</a></h3><p class="job__org">{data.authors.join(', ')}. {data.venue}.</p></div>
            </article>
          ))}
        </section>
        <section aria-labelledby="teaching">
          <SectionHead id="teaching" title="Teaching and training" />
          {teaching.map(({ data }) => <article class="job"><span class="meta">{data.period}</span><div><h3>{data.role}, {data.title}</h3><p class="job__org">{[data.detail, data.org, data.duration].filter(Boolean).join(' · ')}</p></div></article>)}
        </section>
        <section aria-labelledby="projects">
          <SectionHead id="projects" title="Projects" />
          {projects.filter((p) => p.id !== 'tracked-robot-arm').map(({ data }) => <article class="job"><span class="meta">{data.year ?? 'Academic'}</span><div><h3>{data.title}</h3><p class="job__org">{data.context}</p><ul class="tags" style="margin-top:.55rem">{data.tools.map((t) => <li>{t}</li>)}</ul></div></article>)}
        </section>
        <section aria-labelledby="skills">
          <SectionHead id="skills" title="Skills" />
          <dl class="skills">{skills.map((s) => <div><dt>{s.group}</dt><dd><ul class="tags">{s.items.map((i) => <li>{i}</li>)}</ul></dd></div>)}</dl>
        </section>
        <section aria-labelledby="awards">
          <SectionHead id="awards" title="Awards and achievements" />
          {awards.map((a) => <article class="job"><span class="meta">{a.year}</span><p style="font-size:1.2rem;line-height:1.35">{a.text}</p></article>)}
        </section>
      </div>
    </div>
  </div>
</Base>

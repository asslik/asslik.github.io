---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import portrait from '../assets/portrait.jpg';
import { awards, education, profile } from '../data/profile';
import { getExperience, getProjects, getResearch, getTeaching, statusLabel, visible } from '../data/content';

const [research, experience, teaching, projects] = await Promise.all([getResearch(), getExperience(), getTeaching(), getProjects()]);
const featuredProjects = projects.filter((p) => visible(p.data.media).length);
const lecture = teaching.find((t) => t.id === 'visual-slam-lecture')!;
const programme = teaching.find((t) => t.id === 'programme-national')!;
const hall = visible(programme.data.media).find((m) => m.src.src.includes('hall'));
const teachPhotos = [visible(lecture.data.media)[0], hall].filter(Boolean) as NonNullable<typeof hall>[];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name, jobTitle: 'Electrical Engineer',
  description: profile.description, sameAs: [profile.linkedin],
  knowsAbout: ['Computer Vision', 'Visual SLAM', 'Robotics', '3D Gaussian Splatting', 'Deep Learning'],
};
---
<Base hero jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <canvas class="hero__canvas" data-slam aria-hidden="true"></canvas>
    <div class="wrap hero__in">
      <h1 id="hero-title">{profile.name}</h1>
      <p class="hero__role">{profile.headline}</p>
      {profile.intro.map((line) => <p class="hero__intro">{line}</p>)}
      <div class="btn-row">
        <a class="btn btn--solid-light" href="/research/">View research</a>
        <a class="btn btn--light" href={profile.cv} download={profile.cvName}><Icon name="download" /> Download CV</a>
        <a class="btn btn--light" href={profile.linkedin} data-email={profile.email}><Icon name="mail" /> Email me</a>
        <a class="btn btn--light" href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn <Icon name="out" /></a>
      </div>
      <div class="hero__foot">
        <div class="legend" aria-label="Animation legend">
          <span><i></i>Static map <b data-hud="points" style="font-weight:400">0</b></span>
          <span><i class="m"></i>Mirror surface, false depth rejected <b data-hud="rejected" style="font-weight:400">0</b></span>
          <span><i class="d"></i>Moving person, kept out of the map</span>
        </div>
        <div class="hero__controls"><span>Simulated illustration</span><button class="hero__pause" type="button" data-hero-pause>Pause</button></div>
      </div>
    </div>
  </section>

  <section class="section section--sunken" aria-labelledby="about-title">
    <div class="wrap about">
      <Picture class="about__photo" src={portrait} alt="Portrait of Hatim Asslik" formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1200]} sizes="(max-width: 980px) 26rem, 40vw" style="width:100%;border-radius:3px" />
      <div>
        <p class="eyebrow">About</p>
        <h2 id="about-title">Research depth, engineering roots</h2>
        <p class="about__text">I trained as an electrical engineer at EHTP and moved from embedded systems and robotics into computer vision. My PhD research, carried out between UM6P and UTBM, focuses on robust dense visual SLAM.</p>
        <dl class="facts">
          <div><dt>Research</dt><dd>Visual SLAM, depth perception, 3D Gaussian Splatting</dd></div>
          <div><dt>Engineering</dt><dd>PyTorch, OpenCV, Python, C++, embedded systems and IoT</dd></div>
          <div><dt>Languages</dt><dd>Arabic, English, French</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-title">
    <div class="wrap">
      <SectionHead id="experience-title" title="Experience" href="/cv/" linkLabel="Full CV" />
      <ul class="rows">
        {experience.map(({ data }) => (
          <li><span class="meta">{data.period}</span><div><h3>{data.role}</h3><p>{data.org}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="education-title">
    <div class="wrap">
      <SectionHead id="education-title" title="Education" />
      <ul class="rows">
        {education.map((e) => (
          <li><span class="meta">{e.period}</span><div><h3>{e.title}</h3><p>{e.place}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="research-title">
    <div class="wrap">
      <SectionHead id="research-title" title="Selected research" href="/research/" linkLabel="All research" />
      <div>
        {research.map((paper) => {
          const cover = visible(paper.data.media)[0];
          return (
            <article class="plate rise">
              <div class="plate__media"><Figure item={cover} fit="contain" ratio="16 / 10" caption={false} sizes="(max-width: 980px) 100vw, 56vw" /></div>
              <div class="plate__body">
                <div class="plate__meta"><span class="eyebrow">{paper.data.theme}</span><span class:list={['status', `status--${paper.data.status}`]}>{statusLabel[paper.data.status]}</span></div>
                <h3><a href={`/research/${paper.id}/`}>{paper.data.short}</a></h3>
                <p class="plate__sum">{paper.data.summary}</p>
                <div class="plate__stat"><b>{paper.data.highlights[0].value}</b><span>{paper.data.highlights[0].label}</span></div>
                <div class="btn-row">
                  <a class="btn" href={`/research/${paper.id}/read/`}><Icon name="read" /> Read paper</a>
                  <a class="more" href={`/research/${paper.id}/`}>Overview</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="projects-title">
    <div class="wrap">
      <SectionHead id="projects-title" title="Projects" href="/projects/" linkLabel="All projects" />
      <div class="cards">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="teaching-title">
    <div class="wrap">
      <SectionHead id="teaching-title" title="Teaching and training" href="/teaching/" linkLabel="Teaching" />
      <div class="split">
        <div class="stack">
          {teachPhotos.map((item) => <Figure item={item} fit="crop" ratio="16 / 8" sizes="(max-width: 760px) 100vw, 50vw" />)}
        </div>
        <ul class="rows rows--compact">
          {teaching.map(({ data }) => (
            <li><div><h3>{data.title}</h3><p>{data.role}{data.org ? `, ${data.org}` : ''}</p></div><span class="aside">{data.duration}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="awards-title">
    <div class="wrap">
      <SectionHead id="awards-title" title="Awards and Achievements" />
      <ul class="rows rows--text">
        {awards.map((a) => (
          <li><span class="meta">{a.year}</span><p>{a.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <script>
    import '../scripts/slam-hero.ts';
  </script>
</Base>

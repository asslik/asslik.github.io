---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getProjects, visible } from '../../data/content';

const projects = await getProjects();
const featured = projects.filter((p) => visible(p.data.media).length);
const others = projects.filter((p) => !visible(p.data.media).length);
---
<Base title="Projects" description="Engineering projects by Hatim Asslik in robotics, embedded systems, IoT and machine learning.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>Built, wired and tested</h1>
      <p class="lead">Engineering work across robotics, embedded systems, IoT and applied machine learning.</p>
    </header>
    <div class="cards">
      {featured.map(({ id, data }) => {
        const cover = visible(data.media)[0];
        return (
          <article class="card rise">
            <div class:list={['card__media', cover.kind !== 'photo' && 'card__media--plate']}>
              <Picture src={cover.src} alt={cover.alt} formats={['avif']} fallbackFormat="webp" widths={[480, 800, Math.min(1200, cover.src.width)]} sizes="(max-width: 760px) 100vw, 50vw" quality={78} />
            </div>
            <p class="meta">{data.context}{data.year ? ` · ${data.year}` : ''}</p>
            <h3><a href={`/projects/${id}/`}>{data.title}</a></h3>
            <p>{data.summary}</p>
            <ul class="tags">{data.tools.slice(0, 5).map((t) => <li>{t}</li>)}</ul>
          </article>
        );
      })}
    </div>
  </div>
  <section class="section" aria-labelledby="also-title">
    <div class="wrap">
      <SectionHead id="also-title" title="Also built" />
      <ul class="rows">
        {others.map(({ data }) => (
          <li><span class="meta">{data.year ?? 'Academic'}</span><div><h3>{data.title}</h3><p>{data.summary}</p></div><ul class="tags rows__tags">{data.tools.slice(0, 4).map((t) => <li>{t}</li>)}</ul></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
